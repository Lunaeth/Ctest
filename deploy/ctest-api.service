[Unit]
Description=Ctest account and learning progress API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctest
Group=nginx
WorkingDirectory=/opt/ctest-api/current
EnvironmentFile=/etc/ctest/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=ctest-api
RuntimeDirectoryMode=0750
UMask=0007
ExecStartPre=+/usr/bin/chcon -t httpd_var_run_t /run/ctest-api
ExecStart=/opt/ctest-api/start-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ctest /run/ctest-api
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
