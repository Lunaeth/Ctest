[Unit]
Description=Private online backup of Ctest accounts and learning records
After=ctest-api.service

[Service]
Type=oneshot
User=ctest
Group=nginx
WorkingDirectory=/opt/ctest-api/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ctest-api/venv/bin/python -m server.backup --retain 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ctest /var/backups/ctest
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
